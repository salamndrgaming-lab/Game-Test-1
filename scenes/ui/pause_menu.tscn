[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/pause_menu.gd" id="1_pause"]

[node name="PauseMenu" type="CanvasLayer"]
script = ExtResource("1_pause")

[node name="Dim" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0.55)

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Panel" type="PanelContainer" parent="Center"]

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 18

[node name="Stack" type="VBoxContainer" parent="Center/Panel/Margin"]
custom_minimum_size = Vector2(340, 0)
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Center/Panel/Margin/Stack"]
theme_override_font_sizes/font_size = 28
text = "PAUSED
(the storm is not paused)"
horizontal_alignment = 1

[node name="MainBox" type="VBoxContainer" parent="Center/Panel/Margin/Stack"]
unique_name_in_owner = true
theme_override_constants/separation = 8

[node name="ResumeButton" type="Button" parent="Center/Panel/Margin/Stack/MainBox"]
unique_name_in_owner = true
text = "RESUME"

[node name="InviteButton" type="Button" parent="Center/Panel/Margin/Stack/MainBox"]
unique_name_in_owner = true
text = "INVITE FRIENDS (Steam overlay)"

[node name="SettingsButton" type="Button" parent="Center/Panel/Margin/Stack/MainBox"]
unique_name_in_owner = true
text = "SETTINGS"

[node name="LeaveButton" type="Button" parent="Center/Panel/Margin/Stack/MainBox"]
unique_name_in_owner = true
text = "LEAVE SESSION"

[node name="QuitButton" type="Button" parent="Center/Panel/Margin/Stack/MainBox"]
unique_name_in_owner = true
text = "QUIT GAME"

[node name="SettingsBox" type="VBoxContainer" parent="Center/Panel/Margin/Stack"]
unique_name_in_owner = true
visible = false
theme_override_constants/separation = 8

[node name="VolumeLabel" type="Label" parent="Center/Panel/Margin/Stack/SettingsBox"]
text = "Master volume"

[node name="VolumeSlider" type="HSlider" parent="Center/Panel/Margin/Stack/SettingsBox"]
unique_name_in_owner = true
max_value = 1.0
step = 0.05
value = 1.0

[node name="SensLabel" type="Label" parent="Center/Panel/Margin/Stack/SettingsBox"]
text = "Mouse sensitivity"

[node name="SensSlider" type="HSlider" parent="Center/Panel/Margin/Stack/SettingsBox"]
unique_name_in_owner = true
min_value = 0.2
max_value = 3.0
step = 0.1
value = 1.0

[node name="PttCheck" type="CheckButton" parent="Center/Panel/Margin/Stack/SettingsBox"]
unique_name_in_owner = true
text = "Push-to-talk (voice lands in Phase 4)"

[node name="BackButton" type="Button" parent="Center/Panel/Margin/Stack/SettingsBox"]
unique_name_in_owner = true
text = "BACK"
